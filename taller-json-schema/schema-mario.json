{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/product.schema.json",
  "title": "Classificació de la Cursa del Mario Kart",
  "type": "object",
  "required": ["Classificació"],
  "properties": {
    "circuit":{
        "type":"string",
        "description":"noms dels circuits",
        "enum":["Prado Rosquilla","Cataratas Yoshi","Barranco Goloso","Fábrica de Toad"]
    },
    "Classificació":{
        "type":"array",
        "description":"classificació dels jugadors a la carrera",
        "minItems":1,
        "maxItems":20,
        "items":{
            "type":"object",
            "required":["posició","nick-player","personatge","Temps","voltes","Accidents"],
            "properties":{
                "posició":{
                    "type":"integer",
                    "minimum":1,
                    "maximum":20
                },
                "nick-player":{
                    "type":"string"
                },
                "personatge":{
                    "type":"string"
                },
                "color":{
                    "type":"string",
                    "enum":["blanc","negre","groc","blau","roig","verd","taronja","lila","rosa"]
                },
                "Temps":{
                    "type":"string",
                    "pattern": "^[0-9]{1,2}:[0-9]{2}$"
                },
                "voltes":{
                    "type":"integer",
                    "minimum":0,
                    "maximum":5
                },
                "Accidents":{
                    "type":"integer"
                },
                "Nitros":{
                    "type":"integer"
                },
                "Rookie":{
                    "type":"string",
                    "enum":["Si","No"]           
                }
            }
        }
    }
  }
}