{

    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://example.com/product.schema.json",
    "title": "Jugador",
    "description": "inscripció e-games",
    "type": "object",
    "required": ["nom-equip", "jugadors"],
    "properties": {
        "nom-equip":{
            "type": "string",
            "description": "Nom de l'equip"
        },
        "jugadors":{
            "type": "array",
            "description": "Llista de jugadors",
            "minItems": 2,
            "maxItems": 10,
            "items":{
                "type": "object",
                "required": ["num-jugador","DNI","nom","cognom","ciutat","email"],
                "properties":{
                    "num-jugador":{
                        "type": "integer",
                        "description":"Numero de jugadors"
                    },
                    "DNI":{
                        "type": "string",
                        "description":"identificació dels jugadors"
                    },
                    "nom":{
                        "type": "string",
                        "description":"Nom dels jugadors"
                    },
                    "cognom":{
                        "type": "string",
                        "description":"Cognom dels jugadors"
                    },
                    "edat":{
                        "type": "integer",
                        "description":"Edat dels jugadors"
                    },
                    "ciutat":{
                        "type": "string",
                        "description":"Ciutat dels jugadors"
                    },
                    "adreça":{
                        "type": "string",
                        "description":"adreça dels jugadors"
                    },
                    "país":{
                        "type": "string",
                        "description":"Pais dels jugadors"
                    },
                    "telèfon":{
                        "type": "integer",
                        "description":"telefon dels jugadors"
                    },
                    "email":{
                        "type": "string",
                        "description":"correu dels jugadors"
                    } 
                }
            }
        }
    }
}